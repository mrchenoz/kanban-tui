#!/usr/bin/env python3
"""Send an obsidian:// URI as an ntfy notification; tapping it opens the note where you are.

Meant as KANBAN_TUI_NOTE_OPEN_CMD on a headless board host: `ktui-notify-note {uri}`.
Standard library only. Configuration:

  ~/.config/ntfy/ktui-token   access token for a user with write access to the topic
  KTUI_NTFY_URL               server base URL (default https://ntfy.jeremychen.au)
  KTUI_NTFY_TOPIC             topic name      (default ktui-notes)

Exit status is non-zero on any failure so the TUI can show it.
"""

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path
from urllib.parse import parse_qs, unquote, urlparse

TOKEN_FILE = Path.home() / ".config" / "ntfy" / "ktui-token"


def main(argv: list[str]) -> int:
    if len(argv) != 2 or not argv[1].startswith("obsidian://"):
        print("usage: ktui-notify-note <obsidian-uri>", file=sys.stderr)
        return 2
    uri = argv[1]
    server = os.getenv("KTUI_NTFY_URL", "https://ntfy.jeremychen.au").rstrip("/")
    topic = os.getenv("KTUI_NTFY_TOPIC", "ktui-notes")
    try:
        token = TOKEN_FILE.read_text().strip()
    except OSError as exc:
        print(f"token file: {exc}", file=sys.stderr)
        return 3
    query = parse_qs(urlparse(uri).query)
    name = unquote(query.get("file", ["note"])[0])
    # JSON publish (POST to the server root) keeps non-ASCII note names intact;
    # the Title:/Click: headers would not.
    body = json.dumps(
        {
            "topic": topic,
            "title": name,
            "message": "Tap to open in Obsidian",
            "click": uri,
            "tags": ["spiral_notepad"],
        }
    ).encode()
    req = urllib.request.Request(
        server,
        data=body,
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=5):
            pass
    except urllib.error.HTTPError as exc:
        print(f"ntfy {exc.code}: {exc.reason}", file=sys.stderr)
        return 1
    except (urllib.error.URLError, OSError) as exc:
        print(f"ntfy unreachable: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
