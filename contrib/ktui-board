#!/usr/bin/env bash
# Board TUI wrapper for the board host (headless, reached over SSH).
#
# Pressing `o` on a card hands the note's obsidian:// URI to KANBAN_TUI_NOTE_OPEN_CMD.
# Here that is `ktui-notify-note`, which posts the link as an ntfy notification; the user
# taps it on whichever device is in hand (phone, desktop) and Obsidian opens *there*.
# Nothing opens on this host and this host never connects into another machine.
#
# Set KANBAN_TUI_NOTE_OPEN_CMD yourself before launching to override (e.g. leave it
# empty on a desktop with a display: `KANBAN_TUI_NOTE_OPEN_CMD= ktui-board` -> xdg-open).
#
# Launch from another machine:
#   ssh -4 jeremy@p5jc -t tmux new-session -A -s kanban ~/.local/bin/ktui-board
export KANBAN_TUI_NOTE_VAULT="${KANBAN_TUI_NOTE_VAULT:-JCNotes}"
export KANBAN_TUI_LOGS_ROOT="${KANBAN_TUI_LOGS_ROOT:-/home/jeremy/Documents/PKM/JCNotes/JCNotes}"
if [ -z "${KANBAN_TUI_NOTE_OPEN_CMD+x}" ]; then
  export KANBAN_TUI_NOTE_OPEN_CMD="$HOME/.local/bin/ktui-notify-note {uri}"
fi
exec "$HOME/.local/bin/kanban-tui" "$@"
