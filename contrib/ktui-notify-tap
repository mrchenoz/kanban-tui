#!/usr/bin/env bash
# ntfy subscriber hook for a desktop: show the incoming note link as a notification and
# open it only if the user clicks. Wire it up in the ntfy client config:
#
#   subscribe:
#     - topic: ktui-notes
#       command: ~/.local/bin/ktui-notify-tap
#
# ntfy passes the message in NTFY_TITLE / NTFY_MESSAGE and the full JSON in NTFY_RAW.
# Only obsidian:// links are honoured; anything else is dropped silently.
set -u
click="$(printf '%s' "${NTFY_RAW:-}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("click",""))' 2>/dev/null)"
case "$click" in obsidian://*) ;; *) exit 0 ;; esac
title="${NTFY_TITLE:-Note}"
message="${NTFY_MESSAGE:-Tap to open in Obsidian}"
case "$(uname -s)" in
  Darwin)
    # terminal-notifier opens -open's URL when the notification is clicked.
    exec terminal-notifier -title "$title" -message "$message" -open "$click"
    ;;
  *)
    # notify-send prints the action key when the user clicks it; times out otherwise.
    if [ "$(notify-send --action=open=Open -t 20000 "$title" "$message")" = "open" ]; then
      exec "$HOME/.local/bin/open-uri" "$click"
    fi
    ;;
esac
